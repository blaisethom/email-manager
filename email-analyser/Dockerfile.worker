FROM prefecthq/prefect:3-latest

# git is required by the prefect.yaml pull step (clones fresh code per flow run)
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js v22 and Codex CLI (AI_BACKEND=codex runs `codex exec` as a subprocess).
# Auth is handled by the Prokura proxy via ~/.codex/ (same as the dev machine) — no API key env var needed.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g @openai/codex@0.143.0 \
    && rm -rf /var/lib/apt/lists/*

# Trust the Prokura MITM proxy CA so flow runs can make HTTPS calls through it
COPY mitm-ca.crt /usr/local/share/ca-certificates/mitm-ca.crt
RUN update-ca-certificates

ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# Pre-install email-manager dependencies to /opt/em-deps (version-independent --target path,
# so PYTHONPATH doesn't need to know which Python X.Y the image uses).
# Source code is cloned fresh per run (PYTHONPATH=/tmp/em-deps) — this just
# pre-bakes the deps so flows don't need to pip install at runtime.
COPY pyproject.toml /tmp/build/pyproject.toml
RUN mkdir -p /tmp/build/src/email_manager \
    && touch /tmp/build/src/email_manager/__init__.py \
    && pip install --no-cache-dir --target=/opt/em-deps "/tmp/build[postgres,scheduler]" \
    && rm -rf /tmp/build

CMD ["prefect", "worker", "start", "--pool", "default-process"]
