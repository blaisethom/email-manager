# Gmail API Configuration (when EMAIL_BACKEND=gmail)
# Download credentials.json from Google Cloud Console > APIs & Credentials > OAuth 2.0 Client IDs
GMAIL_CREDENTIALS_PATH=../data/gmail_credentials.json
GMAIL_TOKEN_PATH=../data/gmail_token.json
# Comma-separated Gmail label IDs to sync (empty = all mail)

# AI Backend: "claude", "claude-cli", "codex", or "ollama"
AI_BACKEND=codex
CODEX_MODEL=gpt-5.4-mini
EXTRACT_EVENTS_MODEL=gpt-5.5

# Pipeline
AI_BATCH_SIZE=10

# Database
DB_BACKEND=postgres
DB_PATH=../data/email_manager.db
DB_URL=postgresql://postgres:RibiselnPosgresIsTheBest@postgres.svc:5432/postgres
DB_PASSWORD=RibiselnPosgresIsTheBest

# Prefect scheduler (optional — leave blank to run pipelines locally)
# Set to your Prefect server URL to dispatch jobs to Prefect instead of running locally.
# Sync jobs → 'ingest' deployment, global analyse → 'ai-analysis', per-company → 'company-ai'.
PREFECT_API_URL=http://172.21.1.47:4200/api

